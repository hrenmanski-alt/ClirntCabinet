# ── Режим ────────────────────────────────────────────────────────────────────
# demo  — диалог по встроенным сценариям, голос и распознавание в браузере,
#         реальные звонки через mock-провайдер (без ключей и денег)
# openai — LLM + Whisper(STT) + TTS на сервере, нужен OPENAI_API_KEY
AI_CALL_MODE=demo

# Сценарий по умолчанию: sales | support | reminder | generic
AI_CALL_SCENARIO=sales
AI_CALL_LANGUAGE=ru

# ── Мозг и голос (для режима openai) ─────────────────────────────────────────
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=nova

# Можно использовать любой OpenAI-совместимый эндпоинт (локальная модель и т.д.)
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Телефония ────────────────────────────────────────────────────────────────
# mock   — звонок имитируется, transcript виден в API/UI
# twilio — реальные исходящие звонки через Twilio
CALL_PROVIDER=mock

# Россия: Novofon (требует SIP-шлюз Asterisk/FreeSWITCH). Смотри NOVOFON.md
NOVOFON_SIP_HOST=
NOVOFON_SIP_USER=
NOVOFON_SIP_PASSWORD=
NOVOFON_FROM_NUMBER=
NOVOFON_GATEWAY_WS_URL=

# ── Поиск инструментов и прокси ────────────────────────────────────────────
# Токены нужны только для больших лимитов GitHub/Hugging Face API
GITHUB_TOKEN=
HF_TOKEN=
# Иностранный сервер/прокси: например http://USER:PASS@IP:PORT
HTTPS_PROXY=
# Планировщик бизнеса: 0 — локальные правила, 1 — LLM (если доступен)
BUSINESS_PLANNER_LLM=0
# Ставка за час работы при расчёте цены
HOURLY_RATE=3000

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Публичный wss-адрес сервера, доступный извне (например, ngrok):
# PUBLIC_WS_URL=wss://xxxx.ngrok-free.app/ws/twilio
# PUBLIC_BASE_URL=https://xxxx.ngrok-free.app
PUBLIC_WS_URL=
PUBLIC_BASE_URL=

# ── Обработка речи в телефонном потоке ───────────────────────────────────────
# Порог громкости для определения речи и паузы перед ответом
VAD_THRESHOLD=350
SILENCE_MS=700
MAX_UTTERANCE_MS=15000
